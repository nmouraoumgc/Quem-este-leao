# Copiar para .env e preencher. Nunca commitar o .env.

# --- Quiz ---
QEEL_DIFFICULTY=medium
# delay da revelação: 30min | 1h | 3h
QEEL_REVEAL_DELAY=1h
QEEL_TIMEZONE=Europe/Lisbon
QEEL_DRY_RUN=true
QEEL_FORMAT_ID=quem_e_este_leao

# Hora local do post diário (Europe/Lisbon). Os jobs devidos vivem no SQLite.
QEEL_POST_AT=12:00

# --- Caminhos ---
QEEL_DATABASE_PATH=var/quem-e-este-leao.sqlite3
QEEL_PLAYERS_YAML=data/players.yaml
QEEL_OUTPUT_DIR=var/output
QEEL_PREVIEW_DIR=examples
QEEL_ASSETS_DIR=assets

# --- Imagens ---
QEEL_WIKIMEDIA_ENABLED=true
QEEL_HTTP_USER_AGENT=QuemEEsteLeao/1.0 (quiz visual Sporting CP; operador local)
QEEL_WIKIMEDIA_SEARCH_LIMIT=6
QEEL_MAX_IMAGE_CANDIDATES=8
QEEL_MIN_IMAGE_SCORE=35
# Produção: false. true só em testes / desenvolvimento (grava image_kind=SYNTHETIC_TEST).
QEEL_ALLOW_SYNTHETIC=false

# --- X / Twitter (opcional). Sem estas chaves o bot fica em pré-visualização local. ---
QEEL_X_API_KEY=
QEEL_X_API_SECRET=
QEEL_X_ACCESS_TOKEN=
QEEL_X_ACCESS_TOKEN_SECRET=
QEEL_X_BEARER_TOKEN=

# --- Processamento ---
QEEL_OCR_ENABLED=true
QEEL_ABORT_IF_RECOGNIZABLE=true
QEEL_LOG_LEVEL=INFO
